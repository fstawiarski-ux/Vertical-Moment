// HUT_DB ID is a local preview placeholder. Replace with the provisioned D1 ID before deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "vertical-moment-website",
  "routes": [
    {
      "pattern": "verticalmoment.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vertical-moment-website"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "BETTER_AUTH_URL": "https://verticalmoment.com"
  },
  "d1_databases": [
    {
      "binding": "HUT_DB",
      "database_name": "vertical-moment-hut-planner",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/huts"
    }
  ]
}
