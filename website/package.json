{
  "name": "vertical-moment-website",
  "private": true,
  "version": "0.6.0-beta",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "verify-data": "node scripts/verify-data-sync.mjs",
    "verify-canonical": "node scripts/verify-canonical-source.mjs",
    "verify-pwa-content": "node scripts/verify-pwa-content.mjs && node scripts/verify-pilots.mjs",
    "verify-pilots": "node scripts/verify-pilots.mjs",
    "pilot:new": "node scripts/create-pilot.mjs",
    "verify-security": "node scripts/verify-security-boundaries.mjs",
    "predev": "npm run sync-data && npm run sync-huts",
    "prebuild": "npm run sync-data && npm run sync-huts",
    "prebuild:next": "npm run sync-data && npm run sync-huts",
    "prebuild:cloudflare": "npm run sync-data && npm run sync-huts",
    "build": "next build && serwist build serwist.config.mjs",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/copy-service-worker.mjs",
    "build:next": "next build",
    "build:sw": "serwist build serwist.config.mjs",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "sync-huts": "node scripts/sync-huts.mjs",
    "verify-huts": "node scripts/verify-huts.mjs",
    "hut-types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "predeploy": "npm run prepare:huts:release",
    "preupload": "npm run prepare:huts:release",
    "prepare:huts:release": "npm run sync-huts && npm run verify-huts && npm run verify-security && npm run verify-personal-huts",
    "verify-personal-huts": "node scripts/verify-personal-huts.mjs",
    "preview:huts:local": "opennextjs-cloudflare preview --port 3036 --ip localhost --local-upstream localhost:3036 --upstream-protocol http --local"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "idb-keyval": "6.3.0",
    "next": "16.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.183.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@opennextjs/cloudflare": "1.20.9",
    "@serwist/cli": "^9.5.13",
    "@serwist/next": "^9.5.13",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.2",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.25",
    "sharp": "^0.35.5"
  }
}
